# -----------------------------------------------------------------------------
# .env.docker.example -- Variables de entorno para el Frontend con Docker
# -----------------------------------------------------------------------------

# URL base de la API backend. En Docker con proxy Nginx usar /api.
VITE_API_BASE_URL=/api

# Nombre de la aplicacion
VITE_APP_NAME=Carrera de Computacion UPS

# Entorno de ejecucion (development | production)
VITE_APP_ENV=development

# Puerto del host expuesto para el contenedor Nginx
FRONTEND_PORT_HOST=3000
