# -----------------------------------------------------------------------------
# .env.example -- Variables de entorno del Frontend (React + Vite)
# -----------------------------------------------------------------------------

# URL base de la API backend que consumira la SPA
# En desarrollo local sin Docker: http://localhost:1337/api
# En Docker con Nginx: /api
VITE_API_BASE_URL=http://localhost:1337/api

# Nombre de la aplicacion
VITE_APP_NAME=Carrera de Computacion UPS

# Entorno de ejecucion (development | production)
VITE_APP_ENV=development

# Puerto del host para exponer el servidor Nginx (default: 3000)
FRONTEND_PORT_HOST=3000
